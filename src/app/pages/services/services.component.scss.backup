        font-size: 1.1rem;
        margin-bottom: 0.8rem;
      }
    }

    .service-btn {
      padding: 1rem 2rem;
      font-size: 1.1rem;
    }
  }

  .services-section,
  .technology-section,
  .process-section,
  .cta-section {
    padding: 4rem 0;
  }

  .section-header {
    margin-bottom: 3rem;

    h2 {
      font-size: 3.2rem;
      margin-bottom: 1.5rem;
      line-height: 1.2;
    }

    p {
      font-size: 1.4rem;
      max-width: 500px;
      line-height: 1.6;
    }
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: 2rem;
    max-width: 600px;
    padding: 0 1rem;
  }

  .service-card {
    border-radius: 20px;
    width: 100%;

    .service-image {
      height: 200px;
    }

    .service-content {
      padding: 1.5rem;

      .service-icon {
        font-size: 3rem;
        margin-bottom: 1.2rem;
      }

      h3 {
        font-size: 2rem;
        margin-bottom: 1rem;
        line-height: 1.2;
      }

      .service-description {
        font-size: 1.3rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      .service-features {
        gap: 0.6rem;
        margin-bottom: 1.2rem;

        .feature {
          font-size: 0.85rem;
          padding: 0.4rem 0.8rem;
          border-radius: 15px;
        }
      }

      .service-details {
        .detail-item {
          padding: 0.6rem;
          margin-bottom: 0.6rem;
          font-size: 0.9rem;
          border-radius: 8px;

          i {
            font-size: 1rem;
            width: 20px;
          }
        }
      }
    }
  }

  .technology-grid {
    grid-template-columns: 1fr !important;
    gap: 2rem;
    max-width: 600px;
    padding: 0 1rem;
  }

  .tech-card {
    padding: 2rem;
    border-radius: 20px;

    .tech-icon {
      font-size: 4.5rem;
      margin-bottom: 1.5rem;
    }

    h3 {
      font-size: 2.2rem;
      margin-bottom: 1.2rem;
    }

    p {
      font-size: 1.4rem;
      line-height: 1.6;
    }
  }

  .process-timeline {
    max-width: 600px;
    padding: 0 1rem;
    padding-left: 60px;

    &::before {
      left: 30px;
      width: 2px;
    }
  }

  .process-step {
    margin-bottom: 2.5rem;
    position: relative;

    &:nth-child(odd) {
      flex-direction: column;
      align-items: flex-start;

      .step-content {
        margin: 0;
        text-align: left;
        width: 100%;
      }
    }

    .step-number {
      position: absolute;
      left: -60px;
      top: 0;
      width: 60px;
      height: 60px;
      font-size: 1.5rem;
      box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
    }

    .step-content {
      margin: 0;
      padding: 1.5rem;
      border-radius: 15px;
      width: 100%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 215, 0, 0.3);

      h3 {
        font-size: 1.3rem;
        margin-bottom: 0.8rem;
        color: #ffd700;
      }

      p {
        font-size: 1rem;
        line-height: 1.5;
        color: #ddd;
      }
    }
  }

  .cta-content {
    padding: 0 1rem;

    h2 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    p {
      font-size: 1rem;
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
      gap: 1rem;

      .cta-primary,
      .cta-secondary {
        min-width: 200px;
        padding: 1rem 2rem;
        font-size: 1rem;
        border-radius: 25px;
      }
    }
  }
}

