      }

      .service-description {
        font-size: 0.9rem;
        margin-bottom: 0.8rem;
        line-height: 1.3;
      }

      .service-features {
        gap: 0.4rem;
        margin-bottom: 0.8rem;

        .feature {
          font-size: 0.75rem;
          padding: 0.3rem 0.6rem;
          border-radius: 10px;
        }
      }

      .service-details {
        .detail-item {
          padding: 0.4rem;
          margin-bottom: 0.4rem;
          font-size: 0.8rem;
          border-radius: 5px;

          i {
            font-size: 0.85rem;
            width: 16px;
          }
        }
      }
    }
  }

  .technology-grid {
    grid-template-columns: 1fr !important;
    gap: 1.2rem;
    max-width: 450px;
    padding: 0 0.6rem;
  }

  .tech-card {
    padding: 1rem;
    border-radius: 16px;

    .tech-icon {
      font-size: 2.2rem;
      margin-bottom: 0.7rem;
    }

    h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    p {
      font-size: 0.9rem;
      line-height: 1.3;
    }
  }

  .process-timeline {
    max-width: 400px;
    padding: 0 0.6rem;
    padding-left: 40px;

    &::before {
      left: 20px;
      width: 2px;
    }
  }

  .process-step {
    margin-bottom: 1.5rem;
    position: relative;

    &:nth-child(odd) {
      flex-direction: column;
      align-items: flex-start;

      .step-content {
        margin: 0;
        text-align: left;
        width: 100%;
      }
    }

    .step-number {
      left: -40px;
      width: 40px;
      height: 40px;
      font-size: 1.1rem;
      box-shadow: 0 2px 10px rgba(255, 215, 0, 0.3);
    }

    .step-content {
      padding: 1rem;
      border-radius: 15px;
      width: 100%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 215, 0, 0.3);

      h3 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        color: #ffd700;
      }

      p {
        font-size: 0.9rem;
        line-height: 1.3;
        color: #ddd;
      }
    }
  }

  .cta-content {
    padding: 0 0.6rem;

    h2 {
      font-size: 2rem;
      margin-bottom: 0.6rem;
    }

    p {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .cta-buttons {
      gap: 0.6rem;

      .cta-primary,
      .cta-secondary {
        min-width: 160px;
        padding: 0.8rem 1.6rem;
        font-size: 0.9rem;
        border-radius: 20px;
      }
    }
  }
}

/* Extra Small Mobile */
@media (max-width: 360px) {
  .hero-section {
    padding: 2rem 0;

    .hero-title {
      font-size: 1.9rem;
      margin-bottom: 0.6rem;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      max-width: 300px;
    }

    .hero-stats {
      gap: 1rem;
      margin-top: 1.5rem;

      .stat-item .stat-number {
        font-size: 1.8rem;
      }

      .stat-item .stat-label {
        font-size: 0.8rem;
      }
    }
  }

  .services-section,
  .technology-section,
  .process-section,
  .cta-section {
    padding: 2rem 0;
  }

  .section-header {
    margin-bottom: 1.5rem;

    h2 {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }

    p {
      font-size: 0.85rem;
      max-width: 300px;
    }
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: 1rem;
    max-width: 350px;
    padding: 0 0.5rem;
  }

  .technology-grid {
    grid-template-columns: 1fr !important;
    gap: 1.5rem;
    padding: 0 0.5rem;
  }

  .tech-card {
    padding: 1.8rem 1.2rem;
    border-radius: 15px;

    .tech-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
    }

    h3 {
      font-size: 1.8rem;
      margin-bottom: 0.7rem;
    }

    p {
      font-size: 1.2rem;
      line-height: 1.4;
    }
  }

  .service-card {
    border-radius: 14px;
    width: 100%;

    .service-image {
      height: 140px;
    }

    .service-content {
      padding: 0.8rem;

      .service-icon {
        font-size: 1.8rem;
        margin-bottom: 0.6rem;
      }

      h3 {
        font-size: 1.1rem;
        margin-bottom: 0.4rem;
      }

      .service-description {
        font-size: 0.85rem;
        margin-bottom: 0.7rem;
        line-height: 1.2;
      }

      .service-features {
        gap: 0.3rem;
        margin-bottom: 0.7rem;

        .feature {
          font-size: 0.7rem;
          padding: 0.25rem 0.5rem;
          border-radius: 8px;
        }
      }

      .service-details {
        .detail-item {
          padding: 0.3rem;
          margin-bottom: 0.3rem;
          font-size: 0.75rem;
          border-radius: 4px;

          i {
            font-size: 0.8rem;
            width: 14px;
          }
        }
      }
    }
  }

  .technology-grid {
    grid-template-columns: 1fr !important;
    gap: 1.5rem;
    max-width: 400px;
    padding: 0 0.5rem;
  }

  .tech-card {
    padding: 1.5rem 1rem;
    border-radius: 14px;

    .tech-icon {
      font-size: 3.5rem;
      margin-bottom: 0.8rem;
    }

    h3 {
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
    }

    p {
      font-size: 1.1rem;
      line-height: 1.3;
    }
  }

  .process-timeline {
    max-width: 350px;
    padding: 0 0.5rem;

    &::before {
      left: 18px;
    }

    padding-left: 36px;
  }

  .process-step {
    margin-bottom: 1rem;

    .step-number {
      left: -36px;
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }

    .step-content {
      padding: 0.7rem;
      border-radius: 14px;

      h3 {
        font-size: 1rem;
        margin-bottom: 0.3rem;
      }

      p {
        font-size: 0.85rem;
        line-height: 1.2;
      }
    }
  }

  .cta-content {
    padding: 0 0.5rem;

    h2 {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }

    p {
      font-size: 0.85rem;
      margin-bottom: 1.2rem;
    }

    .cta-buttons {
      gap: 0.5rem;

      .cta-primary,
      .cta-secondary {
        min-width: 140px;
        padding: 0.7rem 1.4rem;
        font-size: 0.85rem;
        border-radius: 18px;
      }
    }
  }
}

/* Very Small Mobile */
@media (max-width: 360px) {
  .process-section {
    padding: 3rem 0;

    .section-header {
      margin-bottom: 2rem;

      h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
      }

      p {
        font-size: 0.9rem;
        max-width: 300px;
      }
    }
  }

  .process-timeline {
    max-width: 320px;
    padding: 0 0.5rem;
    padding-left: 35px;

    &::before {
      left: 17.5px;
      width: 2px;
    }
  }

  .process-step {
    margin-bottom: 1.2rem;
    position: relative;

    &:nth-child(odd) {
      flex-direction: column;
      align-items: flex-start;

      .step-content {
        margin: 0;
        text-align: left;
        width: 100%;
      }
    }

    .step-number {
      left: -35px;
      width: 35px;
      height: 35px;
      font-size: 1rem;
      box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
    }

    .step-content {
      padding: 0.8rem;
      border-radius: 12px;
      width: 100%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 215, 0, 0.3);

      h3 {
        font-size: 1rem;
        margin-bottom: 0.4rem;
        color: #ffd700;
      }

      p {
        font-size: 0.85rem;
        line-height: 1.3;
        color: #ddd;
      }
    }
  }
}

/* Landscape Mobile */
@media (max-height: 500px) and (orientation: landscape) {
  .services-page {
    padding-top: 50px;
  }

  .hero-section {
    padding: 2rem 0;

    .hero-title {
      font-size: 2.2rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-stats {
      flex-direction: row;
      gap: 2.5rem;
      margin-top: 1.5rem;
    }
  }

  .services-section,
  .technology-section,
  .process-section,
  .cta-section {
    padding: 2rem 0;
  }

  .section-header {
    margin-bottom: 1.5rem;

    h2 {
      font-size: 1.8rem;
    }

    p {
      font-size: 0.95rem;
    }
  }

  .services-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 600px;
  }

  .service-card.advanced-protection {
    max-width: 100%;
  }

  .technology-grid {
    grid-template-columns: 1fr !important;
    gap: 1.5rem;
    max-width: 700px;
  }

  .process-timeline {
    max-width: 600px;
  }

  .cta-content {
    h2 {
      font-size: 1.8rem;
    }

    .cta-buttons {
      flex-direction: row;
      gap: 1.2rem;
    }
  }
}
