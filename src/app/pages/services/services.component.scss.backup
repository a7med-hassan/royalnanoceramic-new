.services-page {
  padding-top: 70px;
}

// Hero Section
.hero-section {
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  padding: 8rem 0;
  text-align: center;
  position: relative;
  overflow: hidden;

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="%23ffd700" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 215, 0, 0.15) 0%,
      transparent 70%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-title {
    color: #ffd700;
    font-size: 5rem;
    font-weight: bold;
    margin-bottom: 2rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    animation: fadeInUp 1s ease-out;
  }

  .hero-subtitle {
    color: #ccc;
    font-size: 1.8rem;
    margin-bottom: 4rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    animation: fadeInUp 1s ease-out 0.2s both;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 5rem;
    margin-top: 4rem;
    animation: fadeInUp 1s ease-out 0.4s both;

    .stat-item {
      text-align: center;

      .stat-number {
        display: block;
        font-size: 4rem;
        font-weight: bold;
        color: #ffd700;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
      }

      .stat-label {
        color: #ccc;
        font-size: 1.3rem;
        font-weight: 500;
      }
    }
  }
}

// Services Section
.services-section {
  padding: 8rem 0;
  background: #0a0a0a;

  .section-header {
    text-align: center;
    margin-bottom: 5rem;

    h2 {
      color: #ffd700;
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    p {
      color: #ccc;
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.6;
    }
  }

  .services-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 215, 0, 0.2);
    border-radius: 25px;
    overflow: hidden;
    transition: all 0.5s ease;
    position: relative;
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);

    &:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 60px rgba(255, 215, 0, 0.25);
      border-color: rgba(255, 215, 0, 0.6);
    }

    &.premium {
      // Remove premium-specific styling to make all cards uniform
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);

      &:hover {
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        border-color: rgba(255, 255, 255, 0.3);
      }

      // Remove the yellow top border
      &::before {
        display: none;
      }
    }

    .service-content {
      display: flex;
      align-items: center;
      min-height: 400px;
      padding: 0;
      
      .service-info {
        flex: 1;
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .service-image {
        flex: 1;
        position: relative;
        height: 400px;
        overflow: hidden;
        background: #2a2a2a;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.6s ease;
          display: block;
          border-radius: 3%;
          box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }

        .service-overlay {
          position: absolute;
          top: 1.5rem;
          right: 1.5rem;
          z-index: 2;

          .service-badge {
            background: linear-gradient(135deg, #e6c200 0%, #b8860b 100%);
            color: #1a1a1a;
            padding: 0.8rem 1.5rem;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1rem;
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.4);
            animation: pulse 2s infinite;
          }
        }
      }

      &:hover .service-image img {
        transform: scale(1.05);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5);
      }
    }

    .service-icon {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      display: block;
      animation: bounceIn 0.8s ease-out;
    }

    h3 {
      color: #ffd700;
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      font-weight: bold;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    }

    .service-description {
      color: #ccc;
      line-height: 1.7;
      margin-bottom: 2rem;
      font-size: 1.1rem;
    }

    .service-features {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-bottom: 2rem;

      .feature {
        background: rgba(255, 215, 0, 0.15);
        color: #e6c200;
        padding: 0.6rem 1.2rem;
        border-radius: 20px;
        font-size: 0.9rem;
        border: 1px solid rgba(255, 215, 0, 0.3);
        transition: all 0.3s ease;

        &:hover {
          background: rgba(255, 215, 0, 0.25);
          border-color: rgba(255, 215, 0, 0.5);
          transform: translateY(-2px);
        }
      }
    }

    .service-details {
      .detail-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        color: #ccc;
        font-size: 1rem;
        padding: 0.8rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        transition: all 0.3s ease;

        &:hover {
          background: rgba(255, 255, 255, 0.1);
          transform: translateX(5px);
        }

        i {
          color: #ffd700;
          width: 25px;
          text-align: center;
          font-size: 1.1rem;
        }
      }
    }
  }

  // Responsive Design
  @media (max-width: 768px) {
    .services-container {
      gap: 3rem;
    }

    .service-card {
      .service-content {
        flex-direction: column;
        min-height: auto;

        .service-info {
          padding: 2rem;
          order: 2;
        }

        .service-image {
          height: 250px;
          order: 1;
        }
      }

      .service-icon {
        font-size: 2.5rem;
      }

      h3 {
        font-size: 1.5rem;
      }

      .service-description {
        font-size: 1rem;
      }

      .service-features {
        .feature {
          font-size: 0.8rem;
          padding: 0.5rem 1rem;
        }
      }

      .service-details {
        .detail-item {
          font-size: 0.9rem;
          padding: 0.6rem;
        }
      }
    }
  }

  @media (max-width: 480px) {
    .services-container {
      gap: 2rem;
    }

    .service-card {
      .service-content {
        .service-info {
          padding: 1.5rem;
        }

        .service-image {
          height: 200px;
        }
      }

      .service-icon {
        font-size: 2rem;
      }

      h3 {
        font-size: 1.3rem;
      }

      .service-description {
        font-size: 0.95rem;
      }

      .service-features {
        gap: 0.5rem;
        
        .feature {
          font-size: 0.75rem;
          padding: 0.4rem 0.8rem;
        }
      }

      .service-details {
        .detail-item {
          font-size: 0.85rem;
          padding: 0.5rem;
          gap: 0.8rem;

          i {
            font-size: 1rem;
          }
        }
      }
    }
  }
}

// Technology Section
.technology-section {
  padding: 8rem 0;
  background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);

  .section-header {
    text-align: center;
    margin-bottom: 5rem;

    h2 {
      color: #ffd700;
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    p {
      color: #ccc;
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.6;
    }
  }

  .ppf-carousel-wrapper {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;

    .ppf-swiper {
      height: 500px;
      border-radius: 25px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);

      .swiper-slide {
        cursor: pointer;
        transition: all 0.3s ease;

        &:hover {
          transform: scale(1.02);
        }
      }
    }
  }

  .product-slide {
    height: 100%;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(15px);
    border: 2px solid rgba(255, 215, 0, 0.2);

    .product-content {
      display: flex;
      height: 100%;
      align-items: center;

      .product-info {
        flex: 1;
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;

        .product-name {
          color: #ffd700;
          font-size: 2.5rem;
          margin-bottom: 2rem;
          font-weight: bold;
          text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .product-details {
          margin-bottom: 2rem;

          .detail-item {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
            color: #ccc;
            font-size: 1.2rem;
            padding: 1rem 1.5rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 15px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 215, 0, 0.1);

            &:hover {
              background: rgba(255, 255, 255, 0.1);
              transform: translateX(10px);
              border-color: rgba(255, 215, 0, 0.3);
            }

            i {
              color: #ffd700;
              width: 30px;
              text-align: center;
              font-size: 1.3rem;
            }

            strong {
              color: #ffd700;
            }
          }
        }

        .contact-cta {
          display: flex;
          align-items: center;
          gap: 1rem;
          color: #ffd700;
          font-size: 1.3rem;
          font-weight: bold;
          padding: 1rem 2rem;
          background: rgba(255, 215, 0, 0.1);
          border: 2px solid rgba(255, 215, 0, 0.3);
          border-radius: 25px;
          transition: all 0.3s ease;

          &:hover {
            background: rgba(255, 215, 0, 0.2);
            border-color: rgba(255, 215, 0, 0.5);
            transform: translateY(-2px);
          }

          i {
            font-size: 1.5rem;
          }
        }
      }

      .product-image {
        flex: 1;
        height: 100%;
        position: relative;
        overflow: hidden;

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.6s ease;
        }
      }
    }
  }

  .video-section {
    margin: 4rem 0;

    .video-title {
      color: #ffd700;
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 3rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;

      .video-thumbnail {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.4s ease;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);

        &:hover {
          transform: translateY(-10px);
          box-shadow: 0 20px 60px rgba(255, 215, 0, 0.25);

          .play-overlay {
            opacity: 1;
            transform: scale(1.1);
          }

          img {
            transform: scale(1.05);
          }
        }

        img {
          width: 100%;
          height: 200px;
          object-fit: cover;
          transition: transform 0.4s ease;
          display: block;
        }

        .play-overlay {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          background: rgba(0, 0, 0, 0.6);
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0;
          transition: all 0.3s ease;

          i {
            color: #ffd700;
            font-size: 4rem;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
          }
        }
      }
    }
  }


  // Responsive Design
  @media (max-width: 768px) {
    padding: 4rem 0;

    .section-header {
      margin-bottom: 3rem;

      h2 {
        font-size: 2.5rem;
      }

      p {
        font-size: 1.1rem;
      }
    }

    .ppf-carousel-wrapper {
      .ppf-swiper {
        height: 400px;
      }
    }

    .product-slide {
      .product-content {
        flex-direction: column;

        .product-info {
          padding: 2rem;
          order: 2;

          .product-name {
            font-size: 2rem;
            margin-bottom: 1.5rem;
          }

          .product-details {
            margin-bottom: 1.5rem;

            .detail-item {
              font-size: 1rem;
              padding: 0.8rem 1rem;
              gap: 1rem;

              i {
                font-size: 1.1rem;
                width: 25px;
              }
            }
          }

          .contact-cta {
            font-size: 1.1rem;
            padding: 0.8rem 1.5rem;

            i {
              font-size: 1.2rem;
            }
          }
        }

        .product-image {
          order: 1;
          height: 200px;
        }
      }
    }

    .video-section {
      .video-title {
        font-size: 2rem;
      }

      .video-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;

        .video-thumbnail {
          img {
            height: 180px;
          }
        }
      }
    }

  }

  @media (max-width: 480px) {
    .ppf-carousel-wrapper {
      .ppf-swiper {
        height: 350px;
      }
    }

    .product-slide {
      .product-content {
        .product-info {
          padding: 1.5rem;

          .product-name {
            font-size: 1.8rem;
            margin-bottom: 1rem;
          }

          .product-details {
            margin-bottom: 1rem;

            .detail-item {
              font-size: 0.9rem;
              padding: 0.6rem 0.8rem;
              gap: 0.8rem;

              i {
                font-size: 1rem;
                width: 20px;
              }
            }
          }

          .contact-cta {
            font-size: 1rem;
            padding: 0.6rem 1.2rem;

            i {
              font-size: 1.1rem;
            }
          }
        }

        .product-image {
          height: 180px;
        }
      }
    }

    .video-section {
      .video-title {
        font-size: 1.8rem;
      }

      .video-grid {
        .video-thumbnail {
          img {
            height: 150px;
          }

          .play-overlay {
            i {
              font-size: 3rem;
            }
          }
        }
      }
    }

  }
}

