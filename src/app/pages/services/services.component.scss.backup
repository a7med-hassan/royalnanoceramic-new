              font-size: 0.9rem;
              padding: 0.6rem 0.8rem;
              gap: 0.8rem;

              i {
                font-size: 1rem;
                width: 20px;
              }
            }
          }

          .contact-cta {
            font-size: 1rem;
            padding: 0.6rem 1.2rem;

            i {
              font-size: 1.1rem;
            }
          }
        }

        .product-image {
          height: 180px;
        }
      }
    }

    .video-section {
      .video-title {
        font-size: 1.8rem;
      }

      .video-grid {
        .video-thumbnail {
          img {
            height: 150px;
          }

          .play-overlay {
            i {
              font-size: 3rem;
            }
          }
        }
      }
    }
  }
}

// Technology Section
.technology-section {
  padding: 8rem 0;
  background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);

  .section-header {
    text-align: center;
    margin-bottom: 5rem;

    h2 {
      color: #ffd700;
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    p {
      color: #ccc;
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.6;
    }
  }

  .technology-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .tech-card {
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 215, 0, 0.2);
    border-radius: 20px;
    padding: 3rem;
    text-align: center;
    transition: all 0.4s ease;
    backdrop-filter: blur(15px);
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 215, 0, 0.1),
        transparent
      );
      transition: left 0.6s ease;
    }

    &:hover {
      transform: translateY(-15px);
      box-shadow: 0 25px 60px rgba(255, 215, 0, 0.25);
      border-color: rgba(255, 215, 0, 0.5);

      &::before {
        left: 100%;
      }
    }

    &:active {
      transform: translateY(-5px);
      box-shadow: 0 15px 40px rgba(255, 215, 0, 0.2);
    }

    .tech-icon {
      font-size: 4rem;
      margin-bottom: 2rem;
      display: block;
      animation: float 3s ease-in-out infinite;
      color: #ffd700;
      text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
    }

    h3 {
      color: #ffd700;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      font-weight: bold;
    }

    p {
      color: #ccc;
      line-height: 1.7;
      font-size: 1rem;
    }
  }
}

// Process Section
.process-section {
  padding: 8rem 0;
  background: #0a0a0a;

  .section-header {
    text-align: center;
    margin-bottom: 5rem;

    h2 {
      color: #ffd700;
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    p {
      color: #ccc;
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.6;
    }
  }

  .process-timeline {
    max-width: 900px;
    margin: 0 auto;
    position: relative;

    &::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(to bottom, #e6c200, #b8860b, #e6c200);
      transform: translateX(-50%);
    }
  }

  .process-step {
    position: relative;
    margin-bottom: 4rem;
    display: flex;
    align-items: center;

    &:nth-child(odd) {
      flex-direction: row-reverse;

      .step-content {
        margin-right: 3rem;
        margin-left: 0;
        text-align: right;
      }
    }

    .step-number {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #e6c200 0%, #b8860b 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: bold;
      color: #1a1a1a;
      box-shadow: 0 8px 25px rgba(255, 215, 0, 0.4);
      z-index: 2;
      flex-shrink: 0;
      animation: pulse 2s infinite;
    }

    .step-content {
      margin-left: 3rem;
      background: rgba(255, 255, 255, 0.05);
      border: 2px solid rgba(255, 215, 0, 0.2);
      border-radius: 20px;
      padding: 2rem;
      backdrop-filter: blur(15px);
      flex: 1;
      transition: all 0.3s ease;

      &:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(255, 215, 0, 0.2);
        border-color: rgba(255, 215, 0, 0.4);
      }

      h3 {
        color: #ffd700;
        font-size: 1.5rem;
        margin-bottom: 1rem;
        font-weight: bold;
      }

      p {
        color: #ccc;
        line-height: 1.6;
        margin: 0;
        font-size: 1rem;
      }
    }
  }
}

// CTA Section
.cta-section {
  padding: 8rem 0;
  background: linear-gradient(
    135deg,
    rgba(255, 215, 0, 0.15) 0%,
    rgba(184, 134, 11, 0.15) 100%
  );
  text-align: center;

  .cta-content {
    h2 {
      color: #ffd700;
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }

    p {
      color: #ccc;
      font-size: 1.3rem;
      margin-bottom: 4rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;

      .cta-primary,
      .cta-secondary {
        padding: 1.5rem 3rem;
        border: none;
        border-radius: 35px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.4s ease;
        font-size: 1.2rem;
        display: inline-flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        min-width: 250px;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
      }

      .cta-primary {
        background: linear-gradient(135deg, #e6c200 0%, #b8860b 100%);
        color: #1a1a1a;

        &:hover {
          transform: translateY(-5px);
          box-shadow: 0 20px 50px rgba(255, 215, 0, 0.5);
        }
      }

      .cta-secondary {
        background: transparent;
        color: #ffd700;
        border: 3px solid #ffd700;

        &:hover {
          background: #ffd700;
          color: #1a1a1a;
          transform: translateY(-5px);
          box-shadow: 0 20px 50px rgba(255, 215, 0, 0.3);
        }
      }
    }
  }
}

// Animations
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes bounceIn {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
  70% {
    transform: scale(0.9);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

/* Large Desktop */
@media (min-width: 1400px) {
  .services-page {
    padding-top: 80px;
  }

  .hero-section {
    padding: 10rem 0;

    .hero-title {
      font-size: 6rem;
      margin-bottom: 2.5rem;
    }

    .hero-subtitle {
      font-size: 2rem;
      margin-bottom: 5rem;
